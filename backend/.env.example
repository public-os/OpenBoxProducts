POSTGRES_DB=openbox
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
FAST2SMS_API_KEY=
# Google Sign-In — paste your OAuth 2.0 Web Client ID here (same one as frontend VITE_GOOGLE_CLIENT_ID)
GOOGLE_CLIENT_ID=
# Allow all CORS origins in local dev. Set to false (or remove) in production.
CORS_ALLOW_ALL_ORIGINS=true

# Order notification email (Gmail SMTP)
# Password = Google App Password (Account > Security > 2-Step Verification > App Passwords)
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=
ADMIN_NOTIFICATION_EMAIL=

# Telegram bot (Notify Me alerts) — token @BotFather se milta hai
TELEGRAM_BOT_TOKEN=
# telegram_bot.py chala ke apna chat_id nikalo
TELEGRAM_CHAT_ID=

# Delivery details bot (order place hone par info yahan bhi jaati hai)
TELEGRAM_DELIVERY_BOT_TOKEN=
TELEGRAM_DELIVERY_CHAT_ID=

# Razorpay payment gateway (https://dashboard.razorpay.com > Settings > API Keys)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Delivery charge — shop location se customer address ki distance se decide hota hai
# (60 km ke andar free, uske bahar flat Rs.40). Default coords: Shastri Nagar
# Metro Station, Delhi. Apni shop ka exact pin Google Maps par right-click
# karke lat,lng copy karo.
SHOP_LATITUDE=28.6700885
SHOP_LONGITUDE=77.1818589
FREE_DELIVERY_RADIUS_KM=60
DELIVERY_CHARGE=40
# Optional: Google Geocoding API key (address -> lat/lng). Set na ho toh free
# OpenStreetMap Nominatim use hota hai — koi key nahi chahiye.
GOOGLE_MAPS_API_KEY=
